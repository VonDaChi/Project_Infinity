# Python virtual environment
venv/

# Python cache
__pycache__/
*.pyc

# Ignore all generated world-weave files...
*.wwf
*.player
# ...but DO NOT ignore the example key.
!electronistu_weave.wwf
!electronistu_weave.player
*.kate-swp

# Debug-mode interaction logs (generated per session by --debug)
output/*.log
START_HERE.md

# Portable embedded Python distribution (regenerated by setup.bat)
python_embeded/

# WorkBuddy runtime data (AI memory / plans / session state)
.workbuddy/

# Runtime user preferences (language, etc.)
config/settings.yml

# WebUI settings — holds API keys and the LAN access PIN
config/webui.yml
